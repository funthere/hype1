# ============================================
# HYPE Trading Bot Configuration
# Copy this file to .env and fill in your credentials
# ============================================

# ============================================
# ACCOUNT CREDENTIALS (Required for real trading)
# ============================================
# Your Hyperliquid wallet private key (NEVER commit this to git!)
PRIVATE_KEY=your_private_key_here

# Your Hyperliquid wallet address
ADDRESS=your_wallet_address_here

# Optional: API wallet address for cloud trading
ACCOUNT_ADDRESS=

# ============================================
# TRADING MODE
# ============================================
# Set to "true" for testnet trading (no real money, but real orders)
USE_TESTNET=false

# Set to "true" for paper trading (simulated trades with mainnet data)
PAPER_TRADING=true

# Starting capital for paper trading mode (default: 10000)
PAPER_CAPITAL=10000

# ============================================
# STRATEGY SETTINGS
# ============================================
# Asset to trade
ASSET=HYPE

# Timeframe for trading signals
TIMEFRAME=15m

# Leverage multiplier. Mainnet enforces a hard maximum of 2.
LEVERAGE=2

# Intended account loss at the configured stop (0.005 = 0.5%).
# Mainnet enforces a hard maximum of 1%.
RISK_PER_TRADE_PCT=0.005

# Take profit multiplier (based on ATR)
TP_ATR_MULTIPLIER=2.0

# Stop loss multiplier (based on ATR)
SL_ATR_MULTIPLIER=0.4

# Maximum concurrent positions (mainnet hard limit: 1)
MAX_POSITIONS=1

# Maximum trades per day (mainnet hard limit: 5)
MAX_DAILY_TRADES=5

# Maximum notional for a single position. The effective cap is the lower of
# this dollar limit and MAX_POSITION_NOTIONAL_PCT of equity.
MAX_POSITION_NOTIONAL_PCT=0.20
MAX_POSITION_NOTIONAL_USD=2000

# Confidence threshold for signals (0-100)
CONFIDENCE_THRESHOLD=45

# ============================================
# RISK MANAGEMENT
# ============================================
# Maximum daily loss (0.02 = 2%; mainnet hard maximum: 3%)
MAX_DAILY_LOSS_PCT=0.02

# Circuit breaker: Stop trading after N consecutive losses
MAX_CONSECUTIVE_LOSSES=3

# Circuit breaker: Cooldown period in minutes
CIRCUIT_BREAKER_COOLDOWN_MINUTES=30

# Enable circuit breaker
CIRCUIT_BREAKER_ENABLED=true

# ============================================
# NOTIFICATIONS (Telegram)
# ============================================
# Enable Telegram notifications
TELEGRAM_ENABLED=false

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# STORAGE
# ============================================
# SQLite database path
DATABASE_PATH=trading_bot.db

# ============================================
# WEB UI / API
# ============================================
# Enable web UI dashboard
WEB_UI_ENABLED=true

# API server host
WEB_UI_HOST=127.0.0.1

# API server port
WEB_UI_PORT=8000

# API URL for dashboard connection
HYPE_BOT_API_URL=http://127.0.0.1:8000

# ============================================
# EMERGENCY
# ============================================
# Emergency shutdown (stops all trading)
EMERGENCY_SHUTDOWN=false

# Trend-following T2 configuration (live-forward paper candidate —
# docs/PARAMETER_STUDY.md). Used by run_trend_following.py env overrides.
ATR_STOP_MULT=3.0
TRAILING_STOP_MULT=3.5
